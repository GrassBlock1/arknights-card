# Set true to disable the workbench and SPA fallback pages. Card images, embeds,
# and API routes remain available. Invalid values fail requests with 503.
CARD_DISABLE_FRONTEND=false

# Browser CORS for public /api/card reads only; this is not authentication.
# Empty allows same-origin requests only; requests without Origin remain usable.
# Comma-separated exact http/https origins, e.g. https://site.example,http://localhost:5173
# Use canonical origins without paths, trailing slashes, userinfo, query or fragment.
# Invalid entries are ignored; null, wildcards and suffix matching are not supported.
# GET and JSON POST are allowed without cross-origin credentials; login/binding APIs are unchanged.
CARD_ALLOWED_ORIGINS=

# Single-user mode is enabled by default; login/binding APIs are disabled.
# Set false explicitly to enable normal login and stored bindings.
# Pure manual cards remain available; single-user mode hides the source selector.
CARD_SINGLE_USER=true
# Required when enabled: token or cred; keep credentials on the server only.
CARD_SKLAND_CREDENTIAL_TYPE=token
CARD_SKLAND_CREDENTIAL=
# Numeric Arknights account UID associated with the credential.
CARD_SKLAND_UID=
# Required fixed opaque URL-safe share ID: 24–256 letters, digits, _ or -.
# Generate a random ID privately. It grants card access; share only with intended readers.
# The public config API never advertises this ID. Old stored share IDs stop working.
CARD_SINGLE_USER_SHARE_ID=
# Optional routing for requests to Skland and the Hypergryph login service. Empty connects directly.
# Node.js: HTTP(S) forward proxy URL, credentials allowed, e.g. http://user:pass@127.0.0.1:7890
# CARD_SKLAND_PROXY=
# Workers: no TCP proxy support, so use an HTTPS relay instead. Requests keep their method,
# headers (including cred/token) and body, and carry the upstream URL in the url query parameter.
# The relay must forward only as.hypergryph.com and zonai.skland.com to avoid acting as an open proxy.
# Plain HTTP is accepted only for loopback hosts during local development.
# CARD_SKLAND_RELAY_URL=https://relay.example/proxy
# Restart the server after changing environment configuration or credentials.
# Token exchange and single-user profile snapshots are held only in process memory.
# Normal login stores encrypted sessions/bindings in private KV.
# CARD_ENCRYPTION_KEY takes precedence: use a base64-encoded 32-byte key and keep it stable.
# Without it, Node reads or creates encryption.key in CARD_DATA_DIR (default .data/private).
# Workers require CARD_ENCRYPTION_KEY as a Secret and a persistent private storage binding;
# see nitro.config.ts. To keep existing data readable, use the same key when migrating.
# CARD_ENCRYPTION_KEY=
# CARD_DATA_DIR=.data/private

# Exact HTTP(S) origins permitted to read public card data from another site, comma-separated.
# The widget script is public; this list controls only browser access to POST /api/card.
# Never include credentials in the list. Empty means same-origin access only.
# CARD_ALLOWED_ORIGINS=https://blog.example,https://portfolio.example
# Shared server image and profile snapshot TTL in seconds; 0 disables cache reuse.
CARD_CACHE_TTL_SECONDS=900

# Rendered images are cached in memory per server process.
# Image cache bounds; setting either limit to 0 disables image caching.
CARD_CACHE_MAX_BYTES=67108864
CARD_CACHE_MAX_ENTRIES=128
